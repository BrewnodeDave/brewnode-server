[Unit]
Description=Backend Node.JS server
After=network.target

[Service]
Type=simple
User=dave
WorkingDirectory=/home/drinkdeuchars/git/brewnode-server
Environment="NODE_ENV=production"
Environment="PATH=/home/dave/.nvm/versions/node/v20.19.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Use the bin script that works from any directory
ExecStart=/home/drinkdeuchars/git/brewnode-server/bin/brewnode-server

# Restart configuration
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brewnode-server

[Install]
WantedBy=multi-user.target