{
  "name": "@brewnode/server",
  "version": "2.5.0",
  "description": "Comprehensive Node.js backend server for brewery automation and monitoring with BrewNode hardware integration",
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "bin": {
    "brewnode-server": "./bin/brewnode-server"
  },
  "scripts": {
    "prestart": "npm install",
    "start": "node index.js",
    "start:safe": "echo 'Starting with hardware validation...' && node index.js",
    "start:skip-tests": "SKIP_HARDWARE_TESTS=true node index.js",
    "start:service": "./scripts/start-brewery-service.sh",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pi": "jest --config jest.pi.config.js --forceExit --detectOpenHandles",
    "test:pi:watch": "jest --config jest.pi.config.js --watch",
    "test:pi:coverage": "jest --config jest.pi.config.js --coverage --forceExit",
    "test:all": "npm test && npm run test:pi",
    "prepare": "husky",
    "docs": "echo 'Documentation available at https://github.com/BrewnodeDave/brewnode-server#readme'",
    "docs:update": "echo '📚 Documentation updated:' && echo '  ✅ CHANGELOG.md - Version history' && echo '  ✅ README.md - Project overview' && echo '  ✅ docs/ - Technical guides'",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:prerelease": "standard-version --prerelease",
    "release:dry": "standard-version --dry-run",
    "postrelease": "git push --follow-tags origin main && npm publish"
  },
  "keywords": [
    "brewery",
    "automation",
    "brewing",
    "raspberry-pi",
    "iot",
    "hardware-control",
    "temperature-monitoring",
    "brewery-control",
    "beer",
    "brewfather",
    "brewing-software",
    "node.js",
    "express",
    "socket.io",
    "i2c",
    "onewire",
    "industrial-automation",
    "swagger",
    "openapi"
  ],
  "author": {
    "name": "Dave Leitch",
    "email": "dave@brewnode.com",
    "url": "https://github.com/BrewnodeDave"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrewnodeDave/brewnode-server.git"
  },
  "bugs": {
    "url": "https://github.com/BrewnodeDave/brewnode-server/issues"
  },
  "homepage": "https://github.com/BrewnodeDave/brewnode-server#readme",
  "license": "Beerware",
  "engines": {
    "node": ">=18.20.5",
    "npm": ">=8.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "arm"
  ],
  "files": [
    "index.js",
    "api.yaml",
    "controllers/",
    "src/",
    "docs/",
    "LICENCE",
    "README.md",
    "CHANGELOG.md",
    "API_DOCUMENTATION.md",
    "FILE_DOCUMENTATION.md",
    "HARDWARE_DOCUMENTATION.md",
    "HARDWARE_REQUIREMENTS.md",
    "package.json",
    "jest.config.js"
  ],
  "dependencies": {
    "axios": "^1.12.0",
    "connect": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ds18x20": "^0.2.0",
    "mysql": "^2.18.1",
    "nanotimer": "^0.3.15",
    "oas3-tools": "^2.2.3",
    "rollbar": "^2.26.4",
    "socket.io": "^4.8.0"
  },
  "optionalDependencies": {
    "@iiot2k/ds18b20": "^3.0.3",
    "raspi": "^6.0.1",
    "raspi-i2c": "^6.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "socket.io-client": "^4.8.0",
    "standard-version": "^9.5.0",
    "supertest": "^6.3.3"
  }
}
