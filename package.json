{
  "name": "@brewnode/server",
  "version": "2.0.0",
  "description": "Comprehensive Node.js backend server for brewery automation and monitoring with BrewNode hardware integration",
  "main": "index.js",
  "scripts": {
    "prestart": "npm install",
    "start": "node index.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm test",
    "docs": "echo 'Documentation available at https://github.com/BrewnodeDave/brewnode-server#readme'"
  },
  "keywords": [
    "brewery",
    "automation", 
    "brewing",
    "raspberry-pi",
    "iot",
    "hardware-control",
    "temperature-monitoring",
    "brewery-control",
    "beer",
    "brewfather",
    "brewing-software",
    "node.js",
    "express",
    "socket.io",
    "i2c",
    "onewire",
    "industrial-automation",
    "swagger",
    "openapi"
  ],
  "author": {
    "name": "Dave Leitch",
    "email": "dave@brewnode.com",
    "url": "https://github.com/BrewnodeDave"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrewnodeDave/brewnode-server.git"
  },
  "bugs": {
    "url": "https://github.com/BrewnodeDave/brewnode-server/issues"
  },
  "homepage": "https://github.com/BrewnodeDave/brewnode-server#readme",
  "license": "Beerware",
  "engines": {
    "node": ">=18.20.5",
    "npm": ">=8.0.0"
  },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64", "arm"],
  "files": [
    "index.js",
    "api.yaml",
    "controllers/",
    "src/",
    "docs/",
    "README.md",
    "API_DOCUMENTATION.md",
    "FILE_DOCUMENTATION.md", 
    "HARDWARE_DOCUMENTATION.md",
    "HARDWARE_REQUIREMENTS.md",
    "package.json",
    "jest.config.js"
  ],
  "dependencies": {
    "axios": "^1.7.7",
    "connect": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ds18x20": "^0.2.0",
    "js-yaml": "^3.3.0",
    "mysql": "^2.18.1",
    "nanotimer": "^0.3.15",
    "oas3-tools": "^2.2.3",
    "rollbar": "^2.26.4",
    "socket.io": "^4.8.0"
  },
  "optionalDependencies": {
    "@iiot2k/ds18b20": "^3.0.3",
    "raspi": "^6.0.1",
    "raspi-i2c": "^6.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "cross-env": "^7.0.3",
    "socket.io-client": "^4.8.0"
  }
}
